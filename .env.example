PORT=8085
APP_ENV=production

# Set these in your actual .env on the server
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ovc_db

# DATABASE_URL is built automatically by docker-compose from the above vars
# Only needed if running the API outside of docker-compose
DATABASE_URL=postgres://postgres:change-me@localhost:5432/ovc_db?sslmode=disable

JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRY_HOURS=24
